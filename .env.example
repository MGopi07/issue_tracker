# TechIssue Hub — Environment Configuration Template

# Database Connection (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/techissue_hub?schema=public"

# Authentication & Session Security (NextAuth / Auth.js)
# Generate a secure 32-character secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-32-character-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Initial Bootstrap Administrator (For safe initial seeding without code-committed credentials)
ADMIN_BOOTSTRAP_EMAIL="admin@techissuehub.local"
ADMIN_BOOTSTRAP_NAME="System Administrator"
ADMIN_BOOTSTRAP_PASSWORD="ChangeMeOnFirstLogin2026!"

# Application Settings
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="TechIssue Hub"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Upload & File Storage Configuration
# Local storage directory path relative to project root
UPLOAD_STORAGE_PATH="./storage/attachments"
MAX_UPLOAD_SIZE_MB="25"
